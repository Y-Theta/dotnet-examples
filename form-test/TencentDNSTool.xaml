<Window x:Class="form_test.TencentDNSTool"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:form_test"
        xmlns:tencent="clr-namespace:TencentCloud.Dnspod.V20210323.Models;assembly=TencentCloudDnspod"
        mc:Ignorable="d"
        Title="Tencent DNS Tools"
        Height="450"
        Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="FocusMask"
                         Color="#cc7a22"
                         Opacity=".1" />
        <SolidColorBrush x:Key="FocusMask_Border"
                         Color="#cc7a22"
                         Opacity=".5" />
        <Style x:Key="NoBorderBox"
               TargetType="TextBox">
            <Setter Property="BorderThickness"
                    Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Padding"
                    Value="4" />
            <Setter Property="Margin"
                    Value="4,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBox Name="DNSID"
                     Grid.Column="1"
                     Style="{StaticResource NoBorderBox}" />
            <TextBox Name="DNSKEY"
                     Grid.Column="2"
                     Style="{StaticResource NoBorderBox}" />
            <TextBox Name="DNSDOMAIN"
                     Grid.Column="3"
                     Text="y-theta.cn"
                     Style="{StaticResource NoBorderBox}" />
            <Button Grid.Column="5"
                    Width="48"
                    Margin="0,0,8,0"
                    Click="Button_Click">刷 新</Button>
        </Grid>
        <Grid Grid.Row="1"
              Height="24">
            <TextBox Style="{StaticResource NoBorderBox}"
                     TextChanged="TextBox_TextChanged" />
        </Grid>
        <Grid Grid.Row="2">
            <ListView Name="Data"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VirtualizingPanel.ScrollUnit="Item"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SnapsToDevicePixels="True"
                      BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="PART_ROOT"
                                            Background="Transparent">
                                        <Grid Margin="2">
                                            <ContentPresenter Margin="4" />
                                            <Rectangle x:Name="PART_MASK"
                                                       IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="PART_MASK"
                                                    Property="Fill"
                                                    Value="{StaticResource FocusMask}" />
                                            <Setter TargetName="PART_ROOT"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource FocusMask_Border}" />
                                            <Setter TargetName="PART_ROOT"
                                                    Property="BorderThickness"
                                                    Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="tencent:RecordListItem">
                        <Grid HorizontalAlignment="Stretch"
                              KeyDown="Grid_PreviewKeyDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="64"
                                                  MaxWidth="128" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       Padding="2"
                                       FontSize="14" />
                            <Border Grid.Column="1"
                                    CornerRadius="8"
                                    Height="16"
                                    MinWidth="16"
                                    MaxWidth="96"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource FocusMask_Border}">
                                <TextBlock FontSize="10"
                                           Margin="6,1"
                                           Padding="0,1"
                                           HorizontalAlignment="Center"
                                           Foreground="White"
                                           Text="{Binding Type}" />
                            </Border>
                            <TextBox Grid.Column="2"
                                     Style="{StaticResource NoBorderBox}"
                                     BorderThickness="0"
                                     Background="{x:Null}"
                                     Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="4"
                                    Click="Button_Click_1"
                                    Padding="8,0"
                                    Height="20"
                                    Content="提 交"
                                    Foreground="White"
                                    Background="{StaticResource FocusMask_Border}"
                                    BorderThickness="0"
                                    DataContext="{Binding}">
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
